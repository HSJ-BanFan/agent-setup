{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4-flash",
  "provider": {
    "opencode-go": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenCode Go",
      "options": {
        "baseURL": "https://opencode.ai/zen/go/v1",
        "apiKey": "YOUR_OPENCODE_API_KEY"
      },
      "models": {
        "deepseek-v4-flash": { "name": "DeepSeek V4 Flash", "reasoning": true, "attachment": false },
        "deepseek-v4-pro": { "name": "DeepSeek V4 Pro", "reasoning": true, "attachment": false },
        "kimi-k2.6": { "name": "Kimi K2.6", "reasoning": true, "attachment": true },
        "glm-5.2": { "name": "GLM 5.2", "reasoning": true, "attachment": true },
        "gpt-5.6-luna": { "name": "GPT-5.6 Luna", "reasoning": true, "attachment": true },
        "grok-4.5": { "name": "Grok 4.5", "reasoning": true, "attachment": true }
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    }
  }
}
